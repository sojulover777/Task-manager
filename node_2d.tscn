theme_override_font_sizes/font_size = 32
text = "Программа представляет собой программное обеспечение для управления задачами, разработанное студентами лечебного факультета Северного государственного медицинского университета (СГМУ). Авторами проекта являются Проничев Алексей Павлович (220 группа, 2 курс) и Максимчук Севастьян Игоревич (219 группа, 2 курс). Разработка была выполнена в 2026 году.
Основная цель программы — демонстрация функциональных возможностей системы управления задачами. Приложение позволяет пользователям создавать, редактировать, отслеживать и организовывать задачи, обеспечивая удобный интерфейс для эффективного планирования и контроля выполнения поставленных целей. Программа может использоваться как инструмент для повышения личной продуктивности и организации рабочего процесса."
autowrap_mode = 3

